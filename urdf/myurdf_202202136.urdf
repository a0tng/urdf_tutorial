<?xml version="1.0"?>
<!-- 7주차 예제 — 몸통 + 목(revolute) + 머리. 슬라이더로 목을 돌려보세요. -->
<robot name="my_robot">
  <link name="base_link">
    <visual>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
      <material name="gray"><color rgba="0.6 0.6 0.6 1"/></material>
    </visual>
  </link>
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><box size="0.02 0.02 0.2"/></geometry>
      <material name="white"><color rgba="0.9 0.9 0.9 1"/></material>
    </visual>
  </link>
  <link name="joint_ball_1">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="red"><color rgba="0.8 0.2 0.2 1"/></material>
    </visual>
  </link>
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><box size="0.02 0.02 0.2"/></geometry>
      <material name="teal"><color rgba="0.0 0.6 0.63 1"/></material>
    </visual>
  </link>
  <link name="joint_ball_2">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="red"><color rgba="0.8 0.2 0.2 1"/></material>
    </visual>
  </link>
  <link name="ee">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><box size="0.1 0.1 0.05"/></geometry>
      <material name="steel"><color rgba="0.0 0.9 0.63 1"/></material>
    </visual>
  </link>
  <link name="joint_ball_3">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="red"><color rgba="0.8 0.2 0.2 1"/></material>
    </visual>
  </link>
  <joint name="base_link_joint_ball1" type="fixed">
    <parent link="base_link"/>
    <child link="joint_ball_1"/>
    <origin xyz="0 0 0.05"/>
  </joint>
  <joint name="base_link_link1_joint" type="revolute">
    <parent link="joint_ball_1"/>
    <child link="link1"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1.0" velocity="1.0"/>
  </joint>
  <joint name="link1_joint_ball2" type="fixed">
    <parent link="link1"/>
    <child link="joint_ball_2"/>
    <origin xyz="0 0 0.2"/>
  </joint>
  <joint name="link1_link2_joint" type="revolute">
    <parent link="joint_ball_2"/>
    <child link="link2"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1.0" velocity="1.0"/>
  </joint>
  <joint name="link2_joint_ball3" type="fixed">
    <parent link="link2"/>
    <child link="joint_ball_3"/>
    <origin xyz="0 0 0.2"/>
  </joint>
  <joint name="link2_ee_joint" type="continuous">
    <parent link="joint_ball_3"/>
    <child link="ee"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
</robot>
